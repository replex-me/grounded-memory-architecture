{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory-architecture:draft:0.1:model",
  "title": "Experience-grounded memory architecture snapshot",
  "type": "object",
  "properties": {
    "format": {
      "const": "memory-architecture/0.1"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "memories": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/memory"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$"
      }
    }
  },
  "required": [
    "format",
    "revision",
    "inputs",
    "memories",
    "links"
  ],
  "additionalProperties": false,
  "$defs": {
    "context": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "condition": {
          "type": "string"
        },
        "valid_from": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "condition",
        "valid_from",
        "valid_until"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "token": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "actor",
        "reason",
        "token"
      ],
      "additionalProperties": false
    },
    "selector": {
      "type": "object",
      "properties": {
        "input_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "input_id",
        "sha256",
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "origin_group": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "state": {
          "enum": [
            "available",
            "withdrawn"
          ]
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "text",
        "sha256",
        "source",
        "origin_group",
        "observed_at",
        "recorded_at",
        "state"
      ],
      "additionalProperties": false
    },
    "memory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "observation",
            "belief",
            "principle",
            "goal",
            "procedure",
            "question"
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "state": {
          "enum": [
            "candidate",
            "current",
            "superseded",
            "withdrawn"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "text",
        "kind",
        "context",
        "state",
        "review_required",
        "review"
      ],
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "context",
            "supports",
            "opposes",
            "requires",
            "related",
            "revises"
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "state": {
          "enum": [
            "candidate",
            "current",
            "withdrawn"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/selector"
          }
        },
        "review": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "actor": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "actor",
                "reason"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$"
          }
        }
      },
      "required": [
        "id",
        "revision",
        "source",
        "target",
        "type",
        "context",
        "state",
        "basis",
        "review"
      ],
      "additionalProperties": false
    }
  }
}
