{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:memory-architecture:draft:0.2:runtime-change",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "expect": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "expect_units": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "put"
              },
              "type": {
                "const": "input"
              },
              "record": {
                "$ref": "urn:memory-architecture:draft:0.1:model#/$defs/input"
              }
            },
            "required": [
              "op",
              "type",
              "record"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "put"
              },
              "type": {
                "const": "memory"
              },
              "record": {
                "$ref": "urn:memory-architecture:draft:0.1:model#/$defs/memory"
              }
            },
            "required": [
              "op",
              "type",
              "record"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "put"
              },
              "type": {
                "const": "link"
              },
              "record": {
                "$ref": "urn:memory-architecture:draft:0.1:model#/$defs/link"
              }
            },
            "required": [
              "op",
              "type",
              "record"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "withdraw_input"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "invalidate"
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "review"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "token": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "id",
              "token",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "use"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "id",
              "task_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "unit"
              },
              "input_id": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "outcome": {
                "enum": [
                  "integrated",
                  "evidence-only",
                  "unknown",
                  "out-of-scope"
                ]
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "op",
              "input_id",
              "key",
              "start",
              "end",
              "outcome",
              "targets",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "const": "annotate_input"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "origin_group": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observed_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "op",
              "id",
              "origin_group",
              "observed_at"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$"
      }
    }
  },
  "required": [
    "request_id",
    "actor",
    "reason",
    "recorded_at",
    "expect",
    "operations"
  ],
  "additionalProperties": false
}
